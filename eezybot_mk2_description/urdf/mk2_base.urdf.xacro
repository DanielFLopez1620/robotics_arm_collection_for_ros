    <link name="main_arm">
    <visual>
        <origin xyz="-0.0195 -0.0120 0.0175" rpy="0 ${pi} ${-pi/2 - 0.225}"/>
        <geometry>
        <mesh filename="package://eezybot_mk2_description/meshes/EBAmk2_002_mainarm.STL" 
