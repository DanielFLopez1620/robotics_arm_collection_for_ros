<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="base_link" />

    <link name="main_base">
    <visual>
        <origin xyz="-0.041 -0.0444 0" rpy="0 0 0"/>
        <geometry>
        <mesh filename="package://eezybot_mk2_description/meshes/EBAmk2_012_mainbase.STL" 
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="OrangePLA"/>
    </visual>
    <collision>
        <origin xyz="-0.041 -0.0444 0" rpy="0 0 0"/>
        <geometry>
        <mesh filename="package://eezybot_mk2_description/meshes/EBAmk2_012_mainbase.STL" 
            scale="0.001 0.001 0.001"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.0053"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                iyy="0.001" iyz="0.0"
                izz="0.001"/>
    </inertial>
    </link>

    <joint name="main_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="main_base"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="MG996r_1">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
        <mesh filename="package://eezybot_mk2_description/meshes/MG946R-MG946R.stl" 
            scale="1 1 1"/>
        </geometry>
        <material name="BlackPLA"/>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
        <mesh filename="package://eezybot_mk2_description/meshes/MG946R-MG946R.stl" 
            scale="1 1 1"/>
        </geometry>
    </collision>
