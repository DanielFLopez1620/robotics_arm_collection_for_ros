        <origin xyz="0 0 0.019" rpy="0 0 0"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-1.57" upper="1.57" effort="5.0" velocity="1.0"/>
        <dynamics damping="0.1" friction="0.01"/>
        <safety_controller soft_lower_limit="-1.4" soft_upper_limit="1.4" k_position="10" k_velocity="5"/>
        <calibration rising="0.0" falling="0.0"/>
        <mimic joint="MG996r_conn1_joint" multiplier="-1.0" offset="0.0"/>
    </joint>

    <link name="upper_base">
    <visual>
        <origin xyz="-0.0445 0.0405 0" rpy="0 0 ${-pi/2}"/>
