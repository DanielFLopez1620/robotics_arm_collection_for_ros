        <origin xyz="0 0 0"/>
        <mass value="0.0053"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                iyy="0.001" iyz="0.0"
                izz="0.001"/>
    </inertial>
    </link>

    <joint name="MG996r_1_joint" type="fixed">
        <parent link="main_base"/>
        <child link="MG996r_1"/>
        <origin xyz="-0.0075 0.001 0.008" rpy="0 0 0"/>
    </joint>

    <link name="MG996r_conn1">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
        <mesh filename="package://eezybot_mk2_description/meshes/MG946R_piattelo-MG946R_piattelo.stl" 
            scale="1 1 1"/>
        </geometry>
        <material name="BlackPLA"/>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
        <mesh filename="package://eezybot_mk2_description/meshes/MG946R_piattelo-MG946R_piattelo.stl" 
            scale="1 1 1"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.0053"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                iyy="0.001" iyz="0.0"
                izz="0.001"/>
    </inertial>
    </link>

    <joint name="MG996r_conn1_joint" type="revolute">
        <parent link="MG996r_1"/>
        <child link="MG996r_conn1"/>
        <origin xyz="0.01 0 0.0385" rpy="0 0 0"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-1.57" upper="1.57" effort="5.0" velocity="1.0"/>
        <dynamics damping="0.1" friction="0.01"/>
        <safety_controller soft_lower_limit="-1.4" soft_upper_limit="1.4" k_position="10" k_velocity="5"/>
        <calibration rising="0.0" falling="0.0"/>
    </joint>

    <link name="gearservo_1">
    <visual>
        <origin xyz="${-0.012935 * 1.575} ${0.012935 * 1.575} 0" rpy="${pi} 0 0"/>
        <geometry>
