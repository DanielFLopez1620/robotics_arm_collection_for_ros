    <link name="gear_mast">
    <visual>
        <origin xyz="-0.039 0.039 0" rpy="${pi} 0 0"/>
        <geometry>
        <mesh filename="package://eezybot_mk2_description/meshes/EBAmk2_011_gearmast_full.STL" 
