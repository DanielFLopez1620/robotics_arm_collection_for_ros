<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <link name="base_link"/>

    
    <link name="main_base">
    <visual>
        <origin xyz="-0.048 -0.0501 0" rpy="0 0 0"/>
        <geometry>
        <mesh filename="package://eezybot_mk1_description/meshes/EBA_01.00.010_basement.STL" 
            scale="0.001 0.001 0.001"/>
        </geometry>
        <color rgba="11 7 75 1.0"/>  
    </visual>
    <collision>
        <origin xyz="-0.048 -0.0501 0" rpy="0 0 0"/>
        <geometry>
        <mesh filename="package://eezybot_mk1_description/meshes/EBA_01.00.010_basement.STL" 
            scale="0.001 0.001 0.001"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.0053"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                iyy="0.001" iyz="0.0"
                izz="0.001"/>
    </inertial>
    </link>

    <joint name="main_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="main_base"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
<!--  raund plate , figura 2 -->
    <link name="raund_plate">
    <visual>
        <origin xyz="-0.036 -0.036 0.0" rpy="0 0 0"/>
        <geometry>
        <mesh filename="package://eezybot_mk1_description/meshes/EBA_01.00.011_round_plate.STL"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <color rgba="0.2 0.2 0.2 1.0"/>
    </visual>
    <collision>
        <origin xyz="-0.036 -0.036 0.0" rpy="0 0 0"/>
        <geometry>
        <mesh filename="package://eezybot_mk1_description/meshes/EBA_01.00.011_round_plate.STL" 
            scale="0.001 0.001 0.001"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.0053"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                iyy="0.001" iyz="0.0"
                izz="0.001"/>
    </inertial>
    </link>

    <joint name="raund_plate_joint" type="revolute">
        <parent link="main_base"/>
        <child link="raund_plate"/>
        <axis xyz="0 0 1"/>
        <limit effort="1000.0" lower="0.0" upper="360" velocity="1"/>
        <origin xyz="0 0 0.031" rpy="0 0 0"/>
    </joint>
    

    
<!-- -->
     <link name="over_plate">
    <visual>
        <origin xyz="-0.028 -0.041 0" rpy="0 0 0"/>
        <geometry>
        <mesh filename="package://eezybot_mk1_description/meshes/EBA_01.00.001.STL" 
            scale="0.001 0.001 0.001"/>
        </geometry>
        <color rgba="11 7 75 1.0"/>  
    </visual>
    <collision>
        <origin xyz="-0.028 -0.041 0" rpy="0 0 0"/>
        <geometry>
        <mesh filename="package://eezybot_mk1_description/meshes/EBA_01.00.001.STL"
            scale="0.001 0.001 0.001"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.0053"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                iyy="0.001" iyz="0.0"
                izz="0.001"/>
    </inertial>
    </link>

    <joint name="over_plate_joint" type="fixed">
        <parent link="raund_plate"/>
        <child link="over_plate"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

</robot>
